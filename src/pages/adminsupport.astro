---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Listworks from "../components/Listworks.astro";
import Nocache from "../components/Nocache.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import { parseISO, formatDistanceToNow } from "date-fns";
import { es } from "date-fns/locale";

interface Job {
  id: string;
  title: string;
  category: string;
  description: string;
  budget: string;
  skills: string[];
  url: string;
  postedDate: string;
  extractedAt: string;
  paymentVerified: boolean;
  bids: string;
}

let visible = true;
let jobs;

const apiUrl =
  process.env.WORKSCRAP_API_URL ||
  import.meta.env.WORKSCRAP_API_URL ||
  "http://localhost:30506";

console.log(apiUrl);

const response = await fetch(apiUrl + "/listwork");

const data = await response.json();

if (data && data.data.length > 1) {
  const dataOrdenada = data.data.sort((a, b) => {
    return new Date(b.postedDate) - new Date(a.postedDate);
  });

  // console.log(dataOrdenada);
  // console.log(data);

  const relativeDate = (dateToConvert: string) => {
    const dataConvert = parseISO(dateToConvert);
    return formatDistanceToNow(dataConvert, { addSuffix: true, locale: es });
  };

  //filter admin support
  const adminData = dataOrdenada.filter(
    (data) => data.category === "admin support",
  );
  // Fix: Filter out corrupted first element (concatenated skills string)
  jobs = adminData.map((job: Job) => ({
    id: job.id,
    title: job.title,
    category: job.category,
    description: relativeDate(job.postedDate),
    budget: job.budget,
    skills:
      job.skills?.filter((skill: string, index: number) => {
        return index > 0 && skill.trim().length > 0;
      }) || [],
    url: job.url,
    postedDate: job.postedDate,
    extractedAt: job.extractedAt,
    paymentVerified: job.paymentVerified,
    bids: job.bids,
  }));
} else {
  visible = false;
}
---

<Layout>
  <Header />
  {visible ? <Listworks jobs={jobs} /> : <Nocache />}
  <Footer />
</Layout>
