---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Listworks from "../components/Listworks.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";

interface Job {
  id: string;
  title: string;
  description: string;
  budget: string;
  skills: string[];
  url: string;
  postedDate: string;
  extractedAt: string;
  paymentVerified: boolean;
  bids: string;
}

const apiUrl =
  process.env.WORKSCRAP_API_URL ||
  import.meta.env.WORKSCRAP_API_URL ||
  "http://localhost:30506";

console.log(apiUrl);

const response = await fetch(apiUrl + "/listwork");

const data = await response.json();
// Fix: Filter out corrupted first element (concatenated skills string)
const jobs = data.data.map((job: Job) => ({
  id: job.id,
  title: job.title,
  description: job.description,
  budget: job.budget,
  skills:
    job.skills?.filter((skill: string, index: number) => {
      return index > 0 && skill.trim().length > 0;
    }) || [],
  url: job.url,
  postedDate: job.postedDate,
  extractedAt: job.extractedAt,
  paymentVerified: job.paymentVerified,
  bids: job.bids,
}));
---

<Layout>
  <Header />
  <Listworks jobs={jobs} />
  <Footer />
</Layout>
