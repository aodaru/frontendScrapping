---

<header class="sticky top-0 z-40 bg-white/80 shadow-sm backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <h1 class="text-lg font-semibold tracking-tight text-gray-900">
      Remote Jobs
    </h1>
    <button
      id="refresh-btn"
      class="rounded-md px-3 py-1.5 text-sm text-gray-600 transition-all duration-200 hover:bg-gray-100 hover:text-gray-900"
    >
      ↻ Actualizar
    </button>
  </div>
</header>

<script>
  document.getElementById("refresh-btn")?.addEventListener("click", () => {
    window.location.reload();
  });
</script>
