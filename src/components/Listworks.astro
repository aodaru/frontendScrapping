---
interface Props {
  jobs: Array<{
    id: string;
    title: string;
    description: string;
    budget: string;
    skills: string[];
    url: string;
    postedDate: string;
    extractedAt: string;
    paymentVerified: boolean;
    bids: string;
  }>;
}

const { jobs } = Astro.props;
---

<main
  class="mx-auto flex min-h-[60vh] max-w-6xl flex-1 flex-col justify-center px-6 py-8 pb-24"
>
  <div class="rounded-lg border border-gray-200 bg-white p-6">
    <h2 class="mb-6 text-2xl font-semibold tracking-tight text-gray-900">
      Trabajos Remotos
    </h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        jobs.map((job) => (
          <a
            href={job.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-lg border border-gray-100 bg-white p-5 transition-all duration-200 hover:scale-[1.02] hover:border-gray-300"
          >
            <h2 class="text-base font-medium text-gray-900 transition-colors group-hover:text-gray-800">
              {job.title}
            </h2>
            <p class="mt-1 text-sm text-gray-500">{job.company}</p>
            <div class="mt-3 flex items-center gap-3 text-xs text-gray-400">
              <span>{job.location}</span>
              {job.salary && <span class="text-gray-600">{job.salary}</span>}
            </div>
            {job.tags && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {job.tags.map((tag) => (
                  <span class="rounded bg-gray-50 px-2 py-0.5 text-xs text-gray-500">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </div>
</main>
