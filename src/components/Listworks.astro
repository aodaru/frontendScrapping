---
interface Props {
  jobs: Array<{
    id: string;
    title: string;
    description: string;
    budget: string;
    skills: string[];
    url: string;
    postedDate: string;
    extractedAt: string;
    paymentVerified: boolean;
    bids: string;
  }>;
}

const { jobs } = Astro.props;
---

<main
  class="mx-auto flex min-h-[60vh] max-w-6xl flex-1 flex-col justify-center px-6 py-8 pb-24"
>
  <div class="rounded-lg border border-gray-200 bg-white p-6 transition-colors duration-200 dark:border-gray-700 dark:bg-gray-800">
    <h2 class="mb-6 text-2xl font-semibold tracking-tight text-gray-900 transition-colors duration-200 dark:text-gray-100">
      Trabajos Remotos
    </h2>
<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  {
    jobs.map((job) => (
      <article class="group rounded-lg border border-gray-100 bg-white p-5 transition-all duration-200 hover:border-gray-300 hover:shadow-md focus-within:ring-2 focus-within:ring-blue-500 dark:border-gray-700 dark:bg-gray-800 dark:hover:border-gray-600">
        <a
          href={job.url}
          target="_blank"
          rel="noopener noreferrer"
          class="block focus:outline-none"
          aria-label={`Ver trabajo: ${job.title}`}
        >
          <h2 class="text-base font-medium text-gray-900 transition-colors group-hover:text-gray-700 dark:text-gray-100 dark:group-hover:text-gray-300">
            {job.title}
          </h2>
          <p class="mt-1 text-sm text-gray-500 line-clamp-2 dark:text-gray-400">{job.description}</p>
          <div class="mt-3 flex items-center gap-3 text-xs text-gray-400">
            {job.budget && <span class="font-medium text-gray-600 dark:text-gray-300">{job.budget}</span>}
            {job.bids && <span class="text-gray-500 dark:text-gray-400">{job.bids}</span>}
          </div>
          {job.skills && (
            <div class="mt-3 flex flex-wrap gap-1.5" role="list" aria-label="Habilidades requeridas">
              {job.skills.map((skill) => (
                <span class="inline-block rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10 dark:bg-blue-900/50 dark:text-blue-200 dark:ring-blue-400/30" role="listitem">
                  {skill}
                </span>
              ))}
            </div>
          )}
        </a>
      </article>
    ))
  }
</div>
  </div>
</main>
